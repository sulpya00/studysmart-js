{
  "name": "studysmart-js",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c auto \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "db:generate": "npm run db:generate --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:studio": "npm run db:studio --workspace server",
    "db:push": "npm run db:push --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
